# Copy to .env.local for `npm run invoke:*` scripts.
# JWT_SECRET, BACKEND_URL and GATEWAY_TRUST_SECRET are required unless ALLOW_DEV_AUTH_DEFAULTS=true.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
BACKEND_URL=http://127.0.0.1:3000
GATEWAY_TRUST_SECRET=local-dev-trust-secret
# ALLOW_DEV_AUTH_DEFAULTS=true
