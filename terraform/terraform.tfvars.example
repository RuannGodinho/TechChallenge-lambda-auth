aws_region  = "us-east-1"
name_prefix = "techchallenge-eks"
ssm_prefix  = "/techchallenge"

# enable_auth_gateway defaults to true in this repo.
# Secrets via TF_VAR_*: JWT_SECRET, AUTH_EMAIL, AUTH_PASSWORD, GATEWAY_TRUST_SECRET
# Optional: eks_backend_url (otherwise SSM /techchallenge/eks/backend_url)
